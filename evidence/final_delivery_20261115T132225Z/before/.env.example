# Offline defaults. This file contains no credentials.
SPRINTS_LLM=offline
SPRINTS_EMBEDDINGS=hashing
SPRINTS_LIVE_AUTHORIZED=0
# Set only after explicit authorization for paid API requests:
# SPRINTS_OPENAI_MODEL=gpt-6-luna-2024-07-18
# SPRINTS_VERIFICATION_API_KEY=
# The controlled run does not use an ambient OPENAI_API_KEY.
# Set only to an approved, locally present Linux image ID:
# SPRINTS_SANDBOX_IMAGE=sha256:<64 lowercase hex characters>
